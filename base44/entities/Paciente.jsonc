{
  "name": "Paciente",
  "type": "object",
  "properties": {
    "numero_ficha": {
      "type": "string",
      "description": "Número de ficha único con formato P000001"
    },
    "nombre_completo": {
      "type": "string"
    },
    "dni": {
      "type": "string"
    },
    "fecha_nacimiento": {
      "type": "string",
      "format": "date"
    },
    "telefono": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "obra_social": {
      "type": "string"
    },
    "numero_afiliado": {
      "type": "string"
    },
    "direccion": {
      "type": "string"
    },
    "contacto_emergencia": {
      "type": "string"
    },
    "telefono_emergencia": {
      "type": "string"
    },
    "activo": {
      "type": "boolean",
      "default": true
    },
    "obra_social_id": {
      "type": "string",
      "description": "Id de ObraSocial del padrón; vacío = particular"
    },
    "plan": {
      "type": "string"
    },
    "consentimiento_datos": {
      "type": "boolean",
      "default": false,
      "description": "Aceptó el tratamiento de sus datos (Ley 25.326)"
    },
    "consentimiento_fecha": {
      "type": "string",
      "format": "date"
    }
  },
  "required": [
    "nombre_completo",
    "dni",
    "fecha_nacimiento"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": false
  }
}
