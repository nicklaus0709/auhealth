{
  "name": "Turno",
  "type": "object",
  "properties": {
    "paciente": {
      "type": "string",
      "description": "Id del paciente"
    },
    "paciente_nombre": {
      "type": "string"
    },
    "paciente_ficha": {
      "type": "string"
    },
    "fecha": {
      "type": "string",
      "format": "date"
    },
    "hora_inicio": {
      "type": "string"
    },
    "hora_fin": {
      "type": "string"
    },
    "tipo_consulta": {
      "type": "string"
    },
    "estado": {
      "type": "string",
      "enum": [
        "pendiente",
        "confirmado",
        "en_espera",
        "en_consulta",
        "atendido",
        "ausente",
        "cancelado"
      ],
      "default": "pendiente"
    },
    "notas": {
      "type": "string"
    },
    "profesional": {
      "type": "string",
      "description": "Id del Profesional que atiende"
    },
    "profesional_nombre": {
      "type": "string"
    },
    "llegada": {
      "type": "string",
      "format": "date-time",
      "description": "Hora en que el paciente se anunció en recepción"
    },
    "recordatorio_enviado": {
      "type": "string",
      "format": "date-time",
      "description": "Cuándo se envió el último recordatorio"
    },
    "recordatorio_medio": {
      "type": "string",
      "description": "whatsapp o email"
    }
  },
  "required": [
    "paciente",
    "fecha",
    "hora_inicio",
    "hora_fin",
    "tipo_consulta"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "update": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "role": "user"
          }
        }
      ]
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}
