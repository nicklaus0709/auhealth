{
  "name": "HistorialClinico",
  "type": "object",
  "properties": {
    "paciente": {
      "type": "string",
      "description": "Id del paciente"
    },
    "paciente_nombre": {
      "type": "string"
    },
    "paciente_ficha": {
      "type": "string"
    },
    "turno": {
      "type": "string",
      "description": "Id del Turno que originó la atención, si hubo"
    },
    "medico": {
      "type": "string",
      "description": "Id del profesional que registra la atención"
    },
    "medico_nombre": {
      "type": "string"
    },
    "medico_matricula": {
      "type": "string",
      "description": "Matrícula del profesional al momento de firmar"
    },
    "fecha_atencion": {
      "type": "string",
      "format": "date-time"
    },
    "motivo_consulta": {
      "type": "string"
    },
    "diagnostico": {
      "type": "string"
    },
    "diagnostico_cie10": {
      "type": "string",
      "description": "Código CIE-10 del diagnóstico principal"
    },
    "tratamiento": {
      "type": "string"
    },
    "notas": {
      "type": "string"
    },
    "signos_vitales": {
      "type": "object",
      "description": "Signos vitales y antropometría de la consulta",
      "properties": {
        "tension_sistolica": {
          "type": "number"
        },
        "tension_diastolica": {
          "type": "number"
        },
        "frecuencia_cardiaca": {
          "type": "number"
        },
        "frecuencia_respiratoria": {
          "type": "number"
        },
        "temperatura": {
          "type": "number"
        },
        "saturacion": {
          "type": "number"
        },
        "peso": {
          "type": "number",
          "description": "kg"
        },
        "talla": {
          "type": "number",
          "description": "cm"
        },
        "imc": {
          "type": "number"
        },
        "glucemia": {
          "type": "number",
          "description": "mg/dl"
        }
      }
    },
    "adjuntos": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "tamano": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "paciente",
    "motivo_consulta",
    "diagnostico"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.roles": "medico"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.roles": "medico"
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
}
