{
  "name": "HistorialClinico",
  "type": "object",
  "properties": {
    "paciente": {
      "type": "string",
      "description": "Id del paciente"
    },
    "paciente_nombre": {
      "type": "string"
    },
    "paciente_ficha": {
      "type": "string"
    },
    "medico": {
      "type": "string",
      "description": "Id del profesional que registra la atención"
    },
    "medico_nombre": {
      "type": "string"
    },
    "fecha_atencion": {
      "type": "string",
      "format": "date-time"
    },
    "motivo_consulta": {
      "type": "string"
    },
    "diagnostico": {
      "type": "string"
    },
    "tratamiento": {
      "type": "string"
    },
    "notas": {
      "type": "string"
    },
    "adjuntos": {
      "type": "array",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "nombre": {
            "type": "string"
          },
          "url": {
            "type": "string"
          },
          "tipo": {
            "type": "string"
          },
          "tamano": {
            "type": "number"
          }
        }
      }
    }
  },
  "required": [
    "paciente",
    "motivo_consulta",
    "diagnostico"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.roles": "medico"
          }
        }
      ]
    },
    "create": {
      "$or": [
        {
          "user_condition": {
            "role": "admin"
          }
        },
        {
          "user_condition": {
            "data.roles": "medico"
          }
        }
      ]
    },
    "update": false,
    "delete": false
  }
}
